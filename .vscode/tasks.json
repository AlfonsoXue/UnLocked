{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "建置 UnLocked.exe",
      "detail": "以 Windows 內建的 C# 編譯器產生 dist\\UnLocked.exe",
      "type": "shell",
      "command": "build.bat",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "執行測試",
      "detail": "不需 Office 的自動測試",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tests\\Test-UnLocked.ps1"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "建置並執行 UnLocked.exe",
      "type": "process",
      "command": "${workspaceFolder}\\dist\\UnLocked.exe",
      "dependsOn": "建置 UnLocked.exe",
      "problemMatcher": []
    }
  ]
}
